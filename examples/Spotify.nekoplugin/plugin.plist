<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Author</key>
	<string>an example, shipped with Neko</string>
	<key>Extends</key>
	<dict>
		<key>Verbs</key>
		<array>
			<dict>
				<key>Confirm</key>
				<string>Cerco “%@” su Spotify?</string>
				<key>Identifier</key>
				<string>search</string>
				<key>Phrases</key>
				<array>
					<string>metti</string>
					<string>ascolta</string>
					<string>fai sentire</string>
					<string>play</string>
					<string>put on</string>
				</array>
				<key>Summary</key>
				<string>searches Spotify and brings it forward</string>
				<key>Url</key>
				<string>spotify:search:%@</string>
			</dict>
			<dict>
				<key>Command</key>
				<string>volumeup</string>
				<key>Confirm</key>
				<string>Alzo il volume?</string>
				<key>Identifier</key>
				<string>volumeup</string>
				<key>Phrases</key>
				<array>
					<string>alza il volume</string>
					<string>più forte</string>
					<string>alza</string>
					<string>volume up</string>
					<string>louder</string>
				</array>
				<key>Player</key>
				<string>spotify</string>
				<key>Summary</key>
				<string>tells spotify to turn it up</string>
			</dict>
			<dict>
				<key>Command</key>
				<string>volumedown</string>
				<key>Confirm</key>
				<string>Abbasso il volume?</string>
				<key>Identifier</key>
				<string>volumedown</string>
				<key>Phrases</key>
				<array>
					<string>abbassa il volume</string>
					<string>più piano</string>
					<string>abbassa</string>
					<string>volume down</string>
					<string>quieter</string>
				</array>
				<key>Player</key>
				<string>spotify</string>
				<key>Summary</key>
				<string>tells spotify to turn it down</string>
			</dict>
			<dict>
				<key>Command</key>
				<string>pause</string>
				<key>Confirm</key>
				<string>Metto in pausa?</string>
				<key>Identifier</key>
				<string>pause</string>
				<key>Phrases</key>
				<array>
					<string>metti in pausa</string>
					<string>ferma la musica</string>
					<string>pausa</string>
					<string>pause the music</string>
					<string>stop the music</string>
				</array>
				<key>Player</key>
				<string>spotify</string>
				<key>Summary</key>
				<string>tells spotify to pause</string>
			</dict>
			<dict>
				<key>Command</key>
				<string>play</string>
				<key>Confirm</key>
				<string>Riprendo?</string>
				<key>Identifier</key>
				<string>play</string>
				<key>Phrases</key>
				<array>
					<string>riprendi</string>
					<string>riprendi la musica</string>
					<string>resume</string>
					<string>keep playing</string>
				</array>
				<key>Player</key>
				<string>spotify</string>
				<key>Summary</key>
				<string>tells spotify to start again</string>
			</dict>
			<dict>
				<key>Command</key>
				<string>next</string>
				<key>Confirm</key>
				<string>Passo alla prossima?</string>
				<key>Identifier</key>
				<string>next</string>
				<key>Phrases</key>
				<array>
					<string>prossima canzone</string>
					<string>salta questa</string>
					<string>next track</string>
					<string>skip this</string>
				</array>
				<key>Player</key>
				<string>spotify</string>
				<key>Summary</key>
				<string>tells spotify to skip</string>
			</dict>
			<dict>
				<key>Command</key>
				<string>previous</string>
				<key>Confirm</key>
				<string>Torno alla precedente?</string>
				<key>Identifier</key>
				<string>previous</string>
				<key>Phrases</key>
				<array>
					<string>canzone precedente</string>
					<string>torna indietro</string>
					<string>previous track</string>
				</array>
				<key>Player</key>
				<string>spotify</string>
				<key>Summary</key>
				<string>tells spotify to go back</string>
			</dict>
		</array>
	</dict>
	<key>Identifier</key>
	<string>com.example.spotify</string>
	<key>Interface</key>
	<integer>1</integer>
	<key>License</key>
	<string>public domain</string>
	<key>MinimumApp</key>
	<string>2.7</string>
	<key>Name</key>
	<string>Spotify</string>
	<key>Summary</key>
	<string>Volume, pause and skip go straight to Spotify — no Shortcut to make. “Metti Taylor Swift” opens the search in Spotify, because Spotify lets nothing outside it search: its window does that, and then it plays.</string>
	<key>Version</key>
	<string>2.0</string>
	<key>Wants</key>
	<array>
		<string>players</string>
		<string>open</string>
	</array>
</dict>
</plist>

"Size:" = "Dimensione:";
"Fall asleep when idle" = "Si addormenta quando è inattivo";
"Restore Defaults" = "Ripristina predefiniti";
"%.0f pt/s" = "%.0f pt/s";
"%.0f pt" = "%.0f pt";

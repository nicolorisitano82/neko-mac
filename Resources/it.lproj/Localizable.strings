/* Ask Neko */
"Ask Neko" = "Chiedi a Neko";
"Pet" = "Gatto";
"Let me ask Neko questions out loud" = "Posso fare domande a voce a Neko";
"Keystroke:" = "Scorciatoia:";
"Answers from:" = "Risposte da:";
"Shortcut name:" = "Nome scorciatoia:";
"API key:" = "Chiave API:";
"A Shortcut of mine" = "Una mia Scorciatoia";
"A Shortcut" = "Una Scorciatoia";
"Read the answer aloud" = "Leggi la risposta ad alta voce";
"The microphone is asked for the first time you use this, never before." = "Il microfono viene chiesto al primo uso, non prima.";
"Another application already owns that keystroke. Pick a different one." = "Quella scorciatoia è già di un’altra applicazione. Scegline un’altra.";
"Press %@ and ask. Neko listens until you stop talking." = "Premi %@ e chiedi. Neko ascolta finché parli.";
"Name the Shortcut that answers" = "Indica la Scorciatoia che risponde";
"Paste an API key" = "Incolla una chiave API";
"Listening…" = "Ascolto…";
"My ears do not work on this Mac." = "Le mie orecchie non funzionano su questo Mac.";
"You have not let me listen. Microphone, in System Settings." = "Non mi hai dato il permesso di ascoltare. Microfono, in Impostazioni di Sistema.";
"Then I shall keep quiet." = "Allora resto zitto.";
"I could not hear anything at all." = "Non ho sentito proprio nulla.";
"I did not catch that." = "Non ho capito.";
"I have no answer for that." = "Non ho una risposta.";
"Whatever I asked never answered." = "Chi ho interpellato non ha risposto.";
"Neko is about to ask for the microphone" = "Neko sta per chiedere il microfono";
"It listens only while you hold the conversation, from the keystroke until you stop talking. Nothing is recorded and nothing is kept." = "Ascolta solo durante la conversazione, dalla scorciatoia fino a quando smetti di parlare. Niente viene registrato e niente viene conservato.";
"Continue" = "Continua";
"Not now" = "Non ora";
"I am a cat. Ask me again once you have set up an answer." = "Sono un gatto. Richiedimelo quando avrai preparato una risposta.";
"No idea. I mostly chase the cursor." = "Non ne ho idea. Io inseguo cursori.";
"Ask the Shortcut. I have not been given one." = "Chiedi alla Scorciatoia. Non me ne hanno data una.";
"Apple Intelligence, on this Mac" = "Apple Intelligence, su questo Mac";
"Needs macOS 26 or newer" = "Richiede macOS 26 o successivo";
"This Mac does not support Apple Intelligence" = "Questo Mac non supporta Apple Intelligence";
"Turn Apple Intelligence on in System Settings" = "Attiva Apple Intelligence in Impostazioni di Sistema";
"The model is still downloading" = "Il modello si sta ancora scaricando";
"The model is not available" = "Il modello non è disponibile";
"I cannot find a Shortcut called “%@”." = "Non trovo una Scorciatoia chiamata «%@».";
"Set up Ask Neko…" = "Configura Chiedi a Neko…";
"Local model" = "Modello locale";
"Model:" = "Modello:";
"Download" = "Scarica";
"Stop" = "Interrompi";
"Remove" = "Rimuovi";
"A model on this Mac" = "Un modello su questo Mac";
"Downloading %@ — %.0f%%" = "Scarico %@ — %.0f%%";
"That download failed: %@" = "Scaricamento fallito: %@";
"Download a model first" = "Prima scarica un modello";
"This build has no local engine yet — the model can be downloaded ready for it" = "Questa build non ha ancora un motore locale — il modello si può scaricare intanto";
"No engine is compiled into this build yet, so a downloaded model cannot answer. Everything around it is ready: the model can be fetched now and will be used the moment the engine lands." = "In questa build non è ancora compilato alcun motore, quindi un modello scaricato non può rispondere. Tutto il resto è pronto: il modello si può scaricare adesso e verrà usato appena il motore arriva.";
"Ready. Choose “A model on this Mac” under Ask Neko." = "Pronto. Scegli «Un modello su questo Mac» in Chiedi a Neko.";
"Nothing downloaded yet." = "Non è stato scaricato nulla.";
"Models are kept in %@ and nothing else is installed: no daemon, no package manager, no other application." = "I modelli stanno in %@ e non viene installato nient’altro: nessun demone, nessun gestore di pacchetti, nessuna altra applicazione.";
"468 MB, 4-bit — quick, and about as clever as a small cat" = "468 MB, 4 bit — svelto, e intelligente quanto un gatto piccolo";
"1.0 GB, 4-bit — slower, and rather better at answering" = "1,0 GB, 4 bit — più lento, e risponde decisamente meglio";
"sniffing the question" = "annuso la domanda";
"scratching my head" = "mi gratto la testa";
"consulting the ball of yarn" = "consulto il gomitolo";
"staring out of the window" = "guardo fuori dalla finestra";
"chasing the thought" = "inseguo il pensiero";
"There was nothing else to remove." = "Non c’era nient’altro da rimuovere.";
"Removed %lu model(s) that were not in use." = "Rimossi %lu modelli non in uso.";
"No unused models to remove" = "Nessun modello da rimuovere";
"Remove %lu unused model(s) — %@" = "Rimuovi %lu modelli non usati — %@";
"%@ of models on disk. " = "%@ di modelli sul disco. ";
"They are kept in %@ and nothing else is installed: no daemon, no package manager, no other application." = "Stanno in %@ e non viene installato nient’altro: nessun demone, nessun gestore di pacchetti, nessuna altra applicazione.";
"468 MB — answers in a blink, and gets simple facts wrong" = "468 MB — risponde in un lampo, e sbaglia fatti semplici";
"1.0 GB — the smallest one worth believing" = "1,0 GB — il più piccolo a cui credere";
"1.9 GB — good in several languages, a second or two to answer" = "1,9 GB — bravo in più lingue, un secondo o due per rispondere";
"2.0 GB — the best of these at being both right and brief" = "2,0 GB — di questi, il migliore a essere giusto e breve";
"That model file could not be read" = "Quel file di modello non si è potuto leggere";

/* model housekeeping */
"Remove %lu model(s) you are not using?" = "Rimuovo %lu modelli che non stai usando?";
"%@ is kept. The others free %@ and can be downloaded again later." = "%@ resta. Gli altri liberano %@ e possono essere riscaricati più tardi.";
"Cancel" = "Annulla";

/* suggestions while roaming */
"Seven programs in ten minutes: pick one and stay in it." = "Sette programmi in dieci minuti: scegline uno e restaci.";
"Still that same window. Whatever it is, you are winning." = "Sempre quella finestra. Qualunque cosa sia, stai vincendo.";
"A cat would have taken a break by now. Just saying." = "Un gatto si sarebbe già preso una pausa. Dico solo.";
"Let Neko suggest things while it roams" = "Lascia che Neko dia suggerimenti mentre gironzola";
"Suggestions" = "Suggerimenti";
"Roams on its own" = "Gironzola per conto suo";
"At most every:" = "Al massimo ogni:";
"%ld minutes" = "%ld minuti";
"Suggest something now" = "Suggerisci qualcosa adesso";
"Having a look…" = "Sto dando un’occhiata…";
"It said: %@" = "Ha detto: %@";
"No engine answered." = "Nessun motore ha risposto.";
"It had nothing worth saying about this." = "Non aveva niente da dire su questo.";
"Only in the “Roams on its own” behaviour" = "Solo nel comportamento “Gironzola per conto suo”";
"This belongs to one behaviour only. Set Behaviour to “Roams on its own” in the Pet tab: a cat chasing the cursor has its attention elsewhere, and one living on the Dock is already busy." = "Questa cosa vive in un solo comportamento. Imposta Comportamento su “Gironzola per conto suo” nella scheda Animale: un gatto che rincorre il cursore ha la testa altrove, e uno che vive sul Dock è già occupato.";
"While roaming, Neko glances at what you are doing and now and then says something about it — a tip, a nudge, or a joke. It waits until you have been in one application for a while, keeps quiet when you are away from the keyboard, and says nothing at all when it has nothing worth saying." = "Mentre gironzola, Neko dà un’occhiata a quello che stai facendo e di tanto in tanto dice la sua — un consiglio, una spinta o una battuta. Aspetta che tu sia in un programma da un po’, tace quando non sei alla tastiera, e non dice niente quando non ha niente da dire.";
"All it can see, and all that is sent, is this:" = "Tutto quello che vede, e tutto quello che viene inviato, è questo:";
"Nothing is read from inside your documents. Window titles are included only if this Mac has already granted Neko screen recording; the permission is never asked for. With Apple Intelligence or a model on this Mac, none of it leaves the Mac; with ChatGPT, Claude or a Shortcut, it is sent to that service like any other question." = "Niente viene letto dentro i tuoi documenti. I titoli delle finestre sono inclusi solo se questo Mac ha già concesso a Neko la registrazione dello schermo; il permesso non viene mai chiesto. Con Apple Intelligence o un modello su questo Mac non esce niente dal Mac; con ChatGPT, Claude o un comando rapido viene inviato a quel servizio come qualsiasi altra domanda.";

/* curious antics */
"What are you writing?" = "Cosa stai scrivendo?";
"Is it about me?" = "Parla di me?";
"That is a lot of words. Any of them mine?" = "Quante parole. Qualcuna è mia?";
"May I watch you type?" = "Posso guardarti scrivere?";
"Need a hand? I only have paws." = "Serve una mano? Io ho solo zampe.";
"Got it. It was getting away." = "Preso. Stava scappando.";
"This arrow keeps moving. Suspicious." = "Questa freccia si muove sempre. Sospetta.";
"Caught your cursor. You may have it back." = "Ho catturato il cursore. Te lo restituisco.";
"Only while roaming." = "Solo mentre gironzola.";
"It came over to ask what you are writing." = "È venuto a chiedere cosa stai scrivendo.";
"It pounced on the cursor." = "Si è lanciato sul cursore.";
"It went to claw the edge of the screen." = "È andato a graffiare il bordo dello schermo.";
"It wandered over to see what you were up to." = "Si è avvicinato per vedere cosa combini.";
"Curiosity comes with roaming whatever this switch says: every minute or two the cat comes over to the pointer, asks what you are writing, or goes to claw the edge of the screen. That part needs no engine and sends nothing anywhere." = "La curiosità arriva con il gironzolare qualunque cosa dica questo interruttore: ogni minuto o due il gatto si avvicina al puntatore, chiede cosa stai scrivendo, o va a graffiare il bordo dello schermo. Quella parte non usa nessun motore e non invia niente da nessuna parte.";

/* reading the desktop */
"Let it read the text I am working on" = "Lascia che legga il testo su cui sto lavorando";
"Is that thing still not working?" = "Quella cosa non funziona ancora?";
"Long sentence. Does it end well?" = "Frase lunga. Va a finire bene?";
"“%@” is selected but was never downloaded, so %@ is answering instead. " = "“%@” è selezionato ma non è mai stato scaricato, quindi risponde %@. ";
"Window titles are included only if this Mac has already granted Neko screen recording; that permission is never asked for. With Apple Intelligence or a model on this Mac, none of it leaves the Mac; with ChatGPT, Claude or a Shortcut, it is sent to that service like any other question." = "I titoli delle finestre sono inclusi solo se questo Mac ha già concesso a Neko la registrazione dello schermo; quel permesso non viene mai chiesto. Con Apple Intelligence o un modello su questo Mac non esce niente dal Mac; con ChatGPT, Claude o un comando rapido viene inviato a quel servizio come qualsiasi altra domanda.";
"Reading the text is on: what is in the field you are typing in, or under the pointer, is included above and goes wherever the rest of it goes. Password fields are refused, nothing at all is read while macOS has secure keyboard entry on, and only the last few hundred characters are taken." = "La lettura del testo è attiva: quello che c’è nel campo in cui stai scrivendo, o sotto il puntatore, finisce qui sopra e va dove va tutto il resto. I campi password vengono rifiutati, non si legge niente mentre macOS ha l’inserimento sicuro da tastiera attivo, e vengono presi solo le ultime poche centinaia di caratteri.";
"Reading the text is switched on but Neko has no Accessibility permission, so nothing is being read. Open System Settings, Privacy & Security, Accessibility, and allow Neko." = "La lettura del testo è accesa ma Neko non ha il permesso di Accessibilità, quindi non legge niente. Apri Impostazioni di Sistema, Privacy e sicurezza, Accessibilità, e autorizza Neko.";

/* drawings */
"Hold on, I will draw it." = "Un attimo, te lo disegno.";
"Drawings" = "Disegni";
"Let Neko draw when I ask to see something" = "Lascia che Neko disegni quando chiedo di vedere qualcosa";
"Effort:" = "Impegno:";
"%ld steps" = "%ld passi";
"Draw a cat now" = "Disegna un gatto adesso";
"Drawing…" = "Sto disegnando…";
"Drawn in %.0f seconds." = "Disegnato in %.0f secondi.";
"The drawing did not come out." = "Il disegno non è venuto.";
"This build has no drawing program in it." = "Questa build non ha dentro il programma per disegnare.";
"Download the picture model first." = "Prima scarica il modello per le immagini.";
"Drawing is switched off." = "Il disegno è spento.";
"1.6 GB, 8-bit — draws a 512 pixel picture on this Mac's GPU" = "1,6 GB, 8 bit — disegna un'immagine da 512 pixel sulla GPU di questo Mac";
"This build has no drawing program in it, so nothing here can work yet." = "Questa build non ha dentro il programma per disegnare, quindi qui non può funzionare niente.";
"Ask to be shown something — “show me the Colosseum” — and the cat draws it here, on this Mac's GPU, with Stable Diffusion. Nothing is sent anywhere, and it costs nothing but the time." = "Chiedi di vedere qualcosa — “mi mostri il Colosseo?” — e il gatto lo disegna qui, sulla GPU di questo Mac, con Stable Diffusion. Non viene inviato niente da nessuna parte, e non costa altro che il tempo.";
"The model is %@ and has not been downloaded yet. " = "Il modello è %@ e non è ancora stato scaricato. ";
"Measured on this Mac: a 512 pixel picture at 14 steps took 14 seconds to draw, plus about nine to open the model the first time. More steps means a better picture and a longer wait. The model takes %@ of disk. " = "Misurato su questo Mac: un'immagine da 512 pixel a 14 passi ha richiesto 14 secondi, più una decina per aprire il modello la prima volta. Più passi vuol dire immagine migliore e attesa più lunga. Il modello occupa %@ di disco. ";
"The words that describe the picture come from whichever engine Ask Neko is set to; only that sentence leaves the Mac, and only if that engine is a remote one." = "Le parole che descrivono l'immagine vengono dal motore impostato in Chiedi a Neko; solo quella frase esce dal Mac, e solo se quel motore è remoto.";
"A remark is a harder thing to write than an answer, and the smaller local models are not good at it — they come out bland, or in the wrong language, or repeat a word four times. Apple Intelligence, on the Ask Neko tab, does this one much better and costs nothing." = "Una battuta è più difficile da scrivere di una risposta, e i modelli locali piccoli non ci riescono: vengono insipide, o nella lingua sbagliata, o ripetono quattro volte la stessa parola. Apple Intelligence, nella scheda Chiedi a Neko, fa molto meglio questa cosa qui e non costa niente.";
"A remark is a harder thing to write than an answer, and the smaller local models are not good at it. A larger model on the Local model tab, or a remote one, will do better." = "Una battuta è più difficile da scrivere di una risposta, e i modelli locali piccoli non ci riescono. Un modello più grande nella scheda Modello locale, o uno remoto, se la cava meglio.";

/* saving a drawing, and newer models */
"Save" = "Salva";
"Saved" = "Salvata";
"Failed" = "Non riuscito";
"Neko %@.png" = "Neko %@.png";
"1.7 GB — newer than the 1.5B and better at holding to an instruction" = "1,7 GB — più recente dell'1.5B e più fedele alle istruzioni";
"2.3 GB — the best of these outside English" = "2,3 GB — il migliore di questi fuori dall'inglese";
"2.3 GB — the most recent, and the one that follows a brief best" = "2,3 GB — il più recente, e quello che sta meglio alle consegne";
"2.0 GB — right and brief, and a year older than the two below" = "2,0 GB — preciso e breve, e un anno più vecchio dei due sotto";

/* doing things */
"Let it open things when I ask" = "Lascia che apra le cose quando glielo chiedo";
"Open %@?" = "Apro %@?";
"Open %@ in %@?" = "Apro %@ in %@?";
"Open the %@ folder?" = "Apro la cartella %@?";
"Run your shortcut “%@”?" = "Eseguo il tuo comando rapido “%@”?";
"All right, I will not." = "Va bene, lascio stare.";
"Done." = "Fatto.";
"That did not work." = "Non ha funzionato.";
"I cannot do that one." = "Quello non lo so fare.";
"Yes" = "Sì";
"No" = "No";
"It can open an application, an address in a browser, one of your folders in the Finder, or one of your own Shortcuts — those four things and nothing else. It always shows you what it is about to do and waits for a yes; dismissing the bubble is a no. It will not move, copy or delete a file, and it never acts on text it read from the screen: only on what you said out loud." = "Può aprire un'applicazione, un indirizzo nel browser, una delle tue cartelle nel Finder, o un tuo comando rapido — queste quattro cose e nient'altro. Mostra sempre cosa sta per fare e aspetta un sì; chiudere il fumetto vale come no. Non sposta, non copia e non cancella file, e non agisce mai su testo letto dallo schermo: solo su quello che hai detto tu.";

/* files */
"Copy “%@” from %@ to %@?" = "Copio “%@” da %@ a %@?";
"Move “%@” from %@ to %@?" = "Sposto “%@” da %@ a %@?";
"I have not been shown that folder." = "Quella cartella non me l'hai mai mostrata.";
"There is more than one “%@” there." = "Lì ce n'è più di uno che si chiama “%@”.";
"I cannot find “%@” there." = "Lì non trovo “%@”.";
"That is a folder, and I only carry files." = "Quella è una cartella, e io porto solo file.";
"Without your %@ folder I cannot." = "Senza la cartella %@ non posso.";
"Allow" = "Consenti";
"Choose your %@ folder so Neko can work in it. It is the only way in: nothing else can grant this." = "Scegli la tua cartella %@ così Neko può lavorarci. È l'unica strada: nient'altro può concederlo.";
"Show it a folder…" = "Mostragli una cartella…";
"Forget them" = "Dimenticale";
"It has been shown no folders, so it cannot touch a file yet. Handing one over is a panel you fill in yourself; nothing else can grant it." = "Non gli è stata mostrata nessuna cartella, quindi non può toccare nessun file. Consegnargliene una è un pannello che compili tu; nient'altro può concederlo.";
"Folders it has been shown: %@." = "Cartelle che gli hai mostrato: %@.";
"It can open an application, an address in a browser, one of your folders in the Finder, run one of your own Shortcuts, and copy or move a single file between your folders. That list is all of it. It always shows what it is about to do and waits for a yes; dismissing the bubble is a no. It never overwrites, never deletes, and never acts on text it read from the screen — only on what you said out loud." = "Può aprire un'applicazione, un indirizzo nel browser, una delle tue cartelle nel Finder, eseguire un tuo comando rapido, e copiare o spostare un singolo file fra le tue cartelle. Quella lista è tutto. Mostra sempre cosa sta per fare e aspetta un sì; chiudere il fumetto vale come no. Non sovrascrive mai, non cancella mai, e non agisce mai su testo letto dallo schermo: solo su quello che hai detto tu.";

"Remove %lu unused model(s) — %@" = "Eliminar %lu modelos sin usar — %@";
"%@ of models on disk. " = "%@ de modelos en el disco. ";
"They are kept in %@ and nothing else is installed: no daemon, no package manager, no other application." = "Se guardan en %@ y no se instala nada más: ningún demonio, ningún gestor de paquetes, ninguna otra aplicación.";
"468 MB — answers in a blink, and gets simple facts wrong" = "468 MB — responde en un instante, y falla en datos simples";

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- The Save button under a drawing writes there and nowhere else. -->
	<key>com.apple.security.files.downloads.read-write</key>
	<true/>
	<!-- Every file panel in this app is one the person asked for by pressing a
	     button: handing over a folder, choosing a plugin. This is what lets the app
	     actually read what they chose — Powerbox grants access to the picked item
	     through this entitlement, and without it a chosen folder could be shown and
	     then not opened.

	     It was added while chasing "the Add button does absolutely nothing", and it
	     is worth recording that it was *not* the cause: with it removed again, the
	     panel service still started. The cause was the panel being application
	     modal in an app with no Dock icon; the fix is in NekoPluginsPanel. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.personal-information.location</key>
	<true/>
	<!-- Two applications by name, and no others: Music and Spotify. This is what
	     lets "alza il volume" and "prossima canzone" actually do something rather
	     than ask for a Shortcut somebody has never made.

	     Measured before it was designed, because a sandbox is not something to
	     reason about: a throwaway bundle signed exactly like this one read Music's
	     volume, set it and put it back, counted the library, and read Spotify's
	     state and current track — all from inside the sandbox.

	     macOS still asks the person, once per application, under Privacy &
	     Security > Automation, and a refusal there is answered in a sentence that
	     names the setting. The scripts themselves live in NekoPlayer.m and nowhere
	     else; a plugin names a player and a command from two closed lists and can
	     never supply a line of script. -->
	<key>com.apple.security.temporary-exception.apple-events</key>
	<array>
		<string>com.apple.Music</string>
		<string>com.spotify.client</string>
	</array>
</dict>
</plist>
